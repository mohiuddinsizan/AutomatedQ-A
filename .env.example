# Copy this file to ".env" and fill in the values.

# Your Postgres connection string (from Railway -> Postgres -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# A long random secret used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# The first super admin account, created by "npm run db:seed"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME="Super Admin"

# The existing result website's API (Phase 1 import)
EXTERNAL_STUDENT_API_BASE_URL=https://example.com
EXTERNAL_STUDENT_API_KEY=

# Protects the daily import URL. Any long random string.
CRON_SECRET=

# AI for answering student questions. Add one or both; the admin picks which one
# answers in Settings, and the other takes over if it is busy or has no key.
# Gemini (https://aistudio.google.com/apikey):
AI_API=
# OpenAI ChatGPT (https://platform.openai.com/api-keys):
GPT_API=
# Optional model choices:
# OPENAI_MODEL=gpt-5.4-nano
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional: models to use. The fallback is tried when the first is busy or rate limited.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Where question photos and voice notes are stored. On a host whose disk is wiped
# on every deploy, point this at a persistent volume.
# UPLOAD_DIR=./uploads
